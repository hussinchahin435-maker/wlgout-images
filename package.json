{
  "name": "Horimiya Prototype Theme",
  "version": "2.0.0",
  "description": "Comprehensive personal environment theme with wallust integration",
  "repository": "https://github.com/hussinchahin435-maker/horimiya-prototype-theme",
  "license": "MIT",
  "author": "Hussin Chahin",
  "components": {
    "wlogout": {
      "enabled": true,
      "version": "1.0.0",
      "description": "Logout/Power menu theme",
      "required_files": ["layout.json", "style.css", "icons/"]
    },
    "terminal": {
      "enabled": true,
      "version": "1.0.0",
      "description": "Terminal emulator configurations",
      "sub_components": ["kitty", "alacritty", "foot"]
    },
    "shell": {
      "enabled": true,
      "version": "1.0.0",
      "description": "Shell configurations and colorschemes",
      "sub_components": ["zsh", "bash"]
    }
  },
  "features": {
    "wallust_integration": true,
    "component_selection": true,
    "template_rendering": true,
    "auto_detection": true,
    "hyprland_binding": true
  },
  "requirements": {
    "required": ["bash", "mkdir", "ln"],
    "optional": ["wallust", "jq", "python3"],
    "suggested": ["kitty", "alacritty"]
  },
  "supported_os": ["Linux"],
  "tested_distributions": ["Fedora 40+", "Ubuntu 24.04+"]
}
